+            global float * out = dst + (size_t)(c0 + k) * OW;
+            #pragma unroll
+            for (int v = 0; v < VEC; ++v) {
+                if (t0 + v < OW) out[t0 + v] = acc[k][v];
+            }
+        }
+    } else {
+        #pragma unroll
+        for (int k = 0; k < TS_K; ++k) {
+            if (c0 + k >= Cout) continue;   // padded channel, zero weights
+            global float * out = dst + (size_t)(c0 + k) * OW;
+            #pragma unroll
+            for (int v = 0; v < VEC; ++v) {
+                if (t0 + v < OW) out[t0 + v] = acc[k][v];
+            }
+        }
+    }
+}
+
+// Repack [KW, Cin, Cout] -> [Cin, KW, Coutp], run once per weight tensor and
+// cached. Coutp rounds Cout up to a multiple of the tile; the padding is zero,
+// so a work item can load and multiply a whole tile and simply not store the
+// channels that do not exist. One work item per output channel of one (ci, kw).
+kernel void kernel_conv_1d_repack_f16(
+    global const half * src,
+    ulong               off_src,
+    global       half * dst,
+    ulong               off_dst,
+    int Cout, int Coutp, int Cin, int KW
+) {
+    src = (global const half *)((global const char *)src + off_src);
+    dst = (global       half *)((global       char *)dst + off_dst);
+
+    const int co = (int)get_global_id(0);
+    const int kw = (int)get_global_id(1);
+    const int ci = (int)get_global_id(2);
+    if (co >= Coutp || kw >= KW || ci >= Cin) {
+        return;
+    }
+    dst[((size_t)ci * KW + kw) * Coutp + co] = co < Cout
+        ? src[(size_t)co * KW * Cin + (size_t)ci * KW + kw]
+        : (half)0.0f;
+}
diff --git a/src/ggml-opencl/kernels/convtranspose1d.cl b/src/ggml-opencl/kernels/convtranspose1d.cl
new file mode 100644
index 00000000..6c49c40f
--- /dev/null
+++ b/src/ggml-opencl/kernels/convtranspose1d.cl
@@ -0,0 +1,109 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+
+// Output-oriented transposed 1D convolution for Adreno. Work is ordered by
+// output phase (t % stride), turning each phase into a dense row so one weight
+// vector feeds VEC adjacent input positions. Weights are repacked once from
+// ggml's [KW, Cout, Cin] layout to [Cin, KW, Coutp].
+
+#ifndef VEC
+#define VEC 4
+#endif
+#ifndef TS_K
+#define TS_K 16
+#endif
+
+#define DEFINE_CONVT_KERNEL(NAME, KTYPE, LOAD_WEIGHT8)                         \
+kernel void NAME(                                                             \
+    global const KTYPE * knl, ulong off_knl,                                  \
+    global const float * src, ulong off_src,                                  \
+    global float * dst, ulong off_dst,                                        \
+    int Cout, int Coutp, int Cin, int KW, int W, int OW, int s0, int batches) \
+{                                                                             \
+    knl = (global const KTYPE *)((global const char *)knl + off_knl);          \
+    src = (global const float *)((global const char *)src + off_src);          \
+    dst = (global float *)((global char *)dst + off_dst);                      \
+    const int q0 = (int)get_global_id(0) * VEC;                               \
+    const int c0 = (int)get_global_id(1) * TS_K;                              \
+    const int phase_plane = (int)get_global_id(2);                            \
+    const int phase = phase_plane % s0;                                       \
+    const int plane = phase_plane / s0;                                       \
+    if (phase >= OW || c0 >= Cout || plane >= batches) return;                \
+    float acc[TS_K][VEC];                                                      \
+    _Pragma("unroll")                                                        \
+    for (int k = 0; k < TS_K; ++k) {                                          \
+        _Pragma("unroll")                                                    \
+        for (int v = 0; v < VEC; ++v) acc[k][v] = 0.0f;                       \
+    }                                                                         \
+    for (int ci = 0; ci < Cin; ++ci) {                                        \
+        global const float * xrow = src + ((size_t)plane * Cin + ci) * W;     \
+        global const KTYPE * wrow = knl + (size_t)ci * KW * Coutp + c0;       \
+        int n = 0;                                                            \
+        for (int tap = phase; tap < KW; tap += s0, ++n) {                     \
+            global const KTYPE * wp = wrow + (size_t)tap * Coutp;             \
+            float w[TS_K];                                                     \
+            _Pragma("unroll")                                                \
+            for (int k = 0; k + 8 <= TS_K; k += 8) {                         \
+                const float8 h = LOAD_WEIGHT8(wp + k);                         \
+                w[k+0]=h.s0; w[k+1]=h.s1; w[k+2]=h.s2; w[k+3]=h.s3;           \
+                w[k+4]=h.s4; w[k+5]=h.s5; w[k+6]=h.s6; w[k+7]=h.s7;           \
+            }                                                                 \
+            _Pragma("unroll")                                                \
+            for (int k = (TS_K/8)*8; k < TS_K; ++k) w[k] = (float)wp[k];     \
+            float x[VEC];                                                      \
+            _Pragma("unroll")                                                \
+            for (int v = 0; v < VEC; ++v) {                                  \
+                const int it = q0 + v - n;                                    \
+                x[v] = (it >= 0 && it < W) ? xrow[it] : 0.0f;                 \
+            }                                                                 \
+            _Pragma("unroll")                                                \
+            for (int k = 0; k < TS_K; ++k) {                                  \
+                _Pragma("unroll")                                            \
+                for (int v = 0; v < VEC; ++v)                                \
+                    acc[k][v] = mad(w[k], x[v], acc[k][v]);                   \
+            }                                                                 \
+        }                                                                     \
+    }                                                                         \
+    if (c0 + TS_K <= Cout) {                                                  \
+        _Pragma("unroll")                                                    \
+        for (int k = 0; k < TS_K; ++k) {                                      \
+            global float * out = dst + ((size_t)plane*Cout + c0+k) * OW;      \
+            _Pragma("unroll")                                                \
+            for (int v = 0; v < VEC; ++v) {                                  \
+                const int t = phase + (q0 + v) * s0;                          \
+                if (t < OW) out[t] = acc[k][v];                               \
+            }                                                                 \
+        }                                                                     \
+    } else {                                                                  \
+        _Pragma("unroll")                                                    \
+        for (int k = 0; k < TS_K; ++k) if (c0+k < Cout) {                    \
+            global float * out = dst + ((size_t)plane*Cout + c0+k) * OW;      \
+            _Pragma("unroll")                                                \
+            for (int v = 0; v < VEC; ++v) {                                  \
+                const int t = phase + (q0 + v) * s0;                          \
+                if (t < OW) out[t] = acc[k][v];                               \
+            }                                                                 \
+        }                                                                     \
+    }                                                                         \
+}
+
+#define LOAD_F32_8(p) vload8(0, (p))
+#define LOAD_F16_8(p) convert_float8(vload8(0, (p)))
+DEFINE_CONVT_KERNEL(kernel_conv_transpose_1d_f32, float, LOAD_F32_8)
+DEFINE_CONVT_KERNEL(kernel_conv_transpose_1d_f16, half,  LOAD_F16_8)
+
+#define DEFINE_REPACK(NAME, TYPE)                                              \
+kernel void NAME(global const TYPE * src, ulong off_src,                      \
+                 global TYPE * dst, ulong off_dst,                            \
+                 int Cout, int Coutp, int Cin, int KW) {                      \
+    src = (global const TYPE *)((global const char *)src + off_src);           \
+    dst = (global TYPE *)((global char *)dst + off_dst);                       \
+    const int co = (int)get_global_id(0);                                     \
+    const int tap = (int)get_global_id(1);                                    \
+    const int ci = (int)get_global_id(2);                                     \
+    if (co >= Coutp || tap >= KW || ci >= Cin) return;                        \
+    dst[((size_t)ci*KW + tap)*Coutp + co] = co < Cout                         \
+        ? src[((size_t)ci*Cout + co)*KW + tap] : (TYPE)0;                     \
+}
+
+DEFINE_REPACK(kernel_conv_transpose_1d_repack_f32, float)
+DEFINE_REPACK(kernel_conv_transpose_1d_repack_f16, half)
diff --git a/src/ggml-opencl/kernels/div.cl b/src/ggml-opencl/kernels/div.cl
index 6d9b4ade..b250a948 100644
--- a/src/ggml-opencl/kernels/div.cl
+++ b/src/ggml-opencl/kernels/div.cl
@@ -50,6 +50,22 @@ kernel void kernel_div(
     }
 }
 
+kernel void kernel_div_flat(
+        global const float * src0, ulong offset0,
+        global const float * src1, ulong offset1,
+        global       float * dst,  ulong offsetd,
+        ulong ne) {
+    src0 = (global const float *)((global const char *)src0 + offset0);
+    src1 = (global const float *)((global const char *)src1 + offset1);
+    dst  = (global       float *)((global       char *)dst  + offsetd);
+    const size_t i = get_global_id(0)*4;
+    if (i + 4 <= ne) {
+        vstore4(vload4(0, src0 + i) / vload4(0, src1 + i), 0, dst + i);
+    } else {
+        for (size_t j = i; j < ne; ++j) dst[j] = src0[j] / src1[j];
+    }
+}
+
 // assumption: src1 is a row
 // broadcast src1 into src0
 kernel void kernel_div_row(
@@ -136,3 +152,41 @@ kernel void kernel_div_row_f16(
     uint idx1 = gid - (gid/ne)*ne; // get_global_id(0) % ne
     dst[gid] = src0[gid] / src1[idx1];
 }
+
+// src1 broadcasts along dim 0: one scalar per row of src0. The generic kernel
+// handles this correctly but reads src1 with an `i0 % ne10` per element and
+// works one scalar at a time, which measured ~5x off memory bandwidth on
+// Adreno. Kokoro leans on this shape heavily -- every AdaIN scale and every
+// conv bias is a [1, C] operand over a [T, C] tensor, and those rows are odd
+// lengths (15961, 2660), so the tail is handled rather than required away.
+kernel void kernel_div_col(
+        global float * src0,
+        ulong  offset0,
+        global float * src1,
+        ulong  offset1,
+        global float * dst,
+        ulong  offsetd,
+        int    ne00
+) {
+    src0 = (global float*)((global char*)src0 + offset0);
+    src1 = (global float*)((global char*)src1 + offset1);
+    dst  = (global float*)((global char*)dst  + offsetd);
+
+    const int i0 = get_global_id(0)*4;
+    const int i1 = get_global_id(1);
+    if (i0 >= ne00) {
+        return;
+    }
+
+    const float s = src1[i1];
+    global float * a = src0 + (size_t)i1*ne00;
+    global float * d = dst  + (size_t)i1*ne00;
+
+    if (i0 + 4 <= ne00) {
+        vstore4(vload4(0, a + i0) / s, 0, d + i0);
+    } else {
+        for (int j = i0; j < ne00; ++j) {
+            d[j] = a[j] / s;
+        }
+    }
+}
diff --git a/src/ggml-opencl/kernels/lstm.cl b/src/ggml-opencl/kernels/lstm.cl
new file mode 100644
index 00000000..e86c86ed
--- /dev/null
+++ b/src/ggml-opencl/kernels/lstm.cl
@@ -0,0 +1,68 @@
+#define H 256
+#define H4 1024
+
+static inline float sanitize_gate(float x) {
+    return clamp(isfinite(x) ? x : 0.0f, -80.0f, 80.0f);
+}
+
+static inline float sigmoid_stable(float x) {
+    if (x >= 0.0f) {
+        const float z = exp(-x);
+        return 1.0f / (1.0f + z);
+    }
+    const float z = exp(x);
+    return z / (1.0f + z);
+}
+
+kernel void kernel_lstm_fused_h256(
+    global const float * pre_gates, ulong off_pre,
+    global       float * output,   ulong off_out,
+    global const float * weights,
+    global const float * bias,
+    global       float * state,
+    int n_steps, int reverse
+) {
+    pre_gates = (global const float *)((global const char *)pre_gates + off_pre);
+    output    = (global       float *)((global       char *)output    + off_out);
+
+    const int i = (int)get_local_id(0);
+    if (get_group_id(0) != 0 || i >= H) return;
+
+    global float * h = state;
+    global float * c = state + H;
+    h[i] = 0.0f;
+    c[i] = 0.0f;
+    barrier(CLK_GLOBAL_MEM_FENCE);
+
+    for (int step = 0; step < n_steps; ++step) {
+        const int t = reverse ? n_steps - 1 - step : step;
+        global const float * pg = pre_gates + (size_t)t * H4;
+        float gi = bias[i]       + pg[i];
+        float gf = bias[H+i]     + pg[H+i];
+        float gg = bias[2*H+i]   + pg[2*H+i];
+        float go = bias[3*H+i]   + pg[3*H+i];
+
+        for (int k = 0; k < H; ++k) {
+            const float hv = h[k];
+            global const float * wk = weights + (size_t)k * H4 + i;
+            gi = mad(wk[0],   hv, gi);
+            gf = mad(wk[H],   hv, gf);
+            gg = mad(wk[2*H], hv, gg);
+            go = mad(wk[3*H], hv, go);
+        }
+
+        barrier(CLK_GLOBAL_MEM_FENCE);
+        gi = sigmoid_stable(sanitize_gate(gi));
+        gf = sigmoid_stable(sanitize_gate(gf));
+        gg = tanh(sanitize_gate(gg));
+        go = sigmoid_stable(sanitize_gate(go));
+        const float c_raw = gf*c[i] + gi*gg;
+        const float c_new = clamp(isfinite(c_raw) ? c_raw : 0.0f, -50.0f, 50.0f);
+        const float h_raw = go*tanh(c_new);
+        const float h_new = isfinite(h_raw) ? h_raw : 0.0f;
+        c[i] = c_new;
+        h[i] = h_new;
+        output[(size_t)t*H + i] = h_new;
+        barrier(CLK_GLOBAL_MEM_FENCE);
+    }
+}
