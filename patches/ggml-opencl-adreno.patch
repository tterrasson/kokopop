+// ABI for a fused H=256 LSTM carried by GGML_OP_MAP_CUSTOM2. Backends must
+// ignore custom ops whose userdata does not begin with this structure/magic.
+// The host pointers remain owned by the caller for the graph lifetime.
+#define GGML_OPENCL_LSTM_PARAMS_V1_MAGIC UINT64_C(0x4b4f4b4f4c535431)
+struct ggml_opencl_lstm_params_v1 {
+    uint64_t      magic;
+    const float * w_hh_f32; // ggml [H, 4H]: w[k + H*gate]
+    const float * b_hh;     // [4H]
+    int64_t       hidden;
+    int64_t       n_steps;
+    int32_t       reverse;
+};
+
+// Optional model-load prewarm. The pointer is also the cache identity and must
+// remain stable until the backend is freed.
+GGML_BACKEND_API void ggml_backend_opencl_lstm_preload(
+    ggml_backend_t backend, const float * w_hh_f32, int64_t hidden, int64_t four_hidden);
+
 #ifdef  __cplusplus
 }
 #endif
