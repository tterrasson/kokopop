+// True when src1 holds exactly one f32 scalar per row of src0 -- ggml's
+// broadcast along dim 0. kernel_<op>_col handles that case as a contiguous
+// float4 stream instead of the generic per-element `i0 % ne10` walk.
+static bool ggml_cl_can_bcast_col(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    return src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+           src1->ne[0] == 1 &&
+           ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst) &&
+           ggml_are_same_shape(src0, dst) &&
+           ggml_nelements(src1) == src0->ne[1]*src0->ne[2]*src0->ne[3];
+}
