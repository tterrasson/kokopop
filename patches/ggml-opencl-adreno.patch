+}
diff --git a/src/ggml-opencl/kernels/conv1d.cl b/src/ggml-opencl/kernels/conv1d.cl
new file mode 100644
index 00000000..57912e4c
--- /dev/null
+++ b/src/ggml-opencl/kernels/conv1d.cl
@@ -0,0 +1,99 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+
+// Direct 1D convolution for the Kokoro vocoder, written for Adreno.
+//
+// ggml's kernel_conv_2d stages both operands through `local` memory with two
+// barriers per K-block. That is the right shape for a desktop GPU and the
+// wrong one here: Adreno has no fast local scratchpad, and that kernel
+// measures ~19 GFLOPS on a device that does 473. This one holds the whole
+// output tile in registers, issues no barrier, and lets the L1 cache do the
+// sharing -- adjacent work items read overlapping input windows, and every
+// work item along the time axis reads the same weights.
+//
+// Reads ggml's tensors as they are, no repacking:
+//   src [W, 1, Cin] f32, knl [KW, 1, Cin, Cout] f16, dst [OW, 1, Cout] f32,
+// first axis contiguous in each. One work item produces VEC consecutive time
+// steps for TS_K output channels.
+
+#ifndef VEC
+#define VEC 4           // time steps per work item
+#endif
+#ifndef TS_K
+#define TS_K 16         // output channels per work item
+#endif
+
+kernel void kernel_conv_1d(
+    global const half  * knl,
+    ulong                off_knl,
+    global const float * src,
+    ulong                off_src,
+    global       float * dst,
+    ulong                off_dst,
+    int Cout, int Cin,
+    int KW, int W, int OW,
+    int s0, int p0, int d0
+) {
+    knl = (global const half  *)((global const char *)knl + off_knl);
+    src = (global const float *)((global const char *)src + off_src);
+    dst = (global       float *)((global       char *)dst + off_dst);
+
+    const int t0 = (int)get_global_id(0) * VEC;
+    const int c0 = (int)get_global_id(1) * TS_K;
+    if (t0 >= OW || c0 >= Cout) {
+        return;
+    }
+
+    float acc[TS_K][VEC];
+    #pragma unroll
+    for (int k = 0; k < TS_K; ++k) {
+        #pragma unroll
+        for (int v = 0; v < VEC; ++v) {
+            acc[k][v] = 0.0f;
+        }
+    }
+
+    // Interior work items skip the per-tap bounds test. Only the first and
+    // last few of each row take the guarded path.
+    const int lo = t0 * s0 - p0;
+    const int hi = (t0 + VEC - 1) * s0 - p0 + (KW - 1) * d0;
+    const bool interior = (lo >= 0) && (hi < W) && (t0 + VEC <= OW);
+
+    for (int ci = 0; ci < Cin; ++ci) {
+        global const float * xrow = src + (size_t)ci * W;
+        global const half  * wcol = knl + (size_t)ci * KW + (size_t)c0 * KW * Cin;
+
+        for (int kw = 0; kw < KW; ++kw) {
+            float x[VEC];
+            if (interior) {
+                #pragma unroll
+                for (int v = 0; v < VEC; ++v) {
+                    x[v] = xrow[lo + v * s0 + kw * d0];
+                }
+            } else {
+                #pragma unroll
+                for (int v = 0; v < VEC; ++v) {
+                    const int idx = (t0 + v) * s0 - p0 + kw * d0;
+                    x[v] = (idx >= 0 && idx < W) ? xrow[idx] : 0.0f;
+                }
+            }
+
+            #pragma unroll
+            for (int k = 0; k < TS_K; ++k) {
+                const float w = (float)wcol[kw + (size_t)k * KW * Cin];
+                #pragma unroll
+                for (int v = 0; v < VEC; ++v) {
+                    acc[k][v] = mad(w, x[v], acc[k][v]);
+                }
+            }
+        }
+    }
+
+    #pragma unroll
+    for (int k = 0; k < TS_K; ++k) {
+        global float * out = dst + (size_t)(c0 + k) * OW;
+        #pragma unroll
+        for (int v = 0; v < VEC; ++v) {
+            if (t0 + v < OW) out[t0 + v] = acc[k][v];
+        }
+    }
+}
