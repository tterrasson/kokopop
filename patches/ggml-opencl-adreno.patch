+    std::memcpy(&custom, op->op_params, sizeof(custom));
+    if (custom.userdata == nullptr) {
+        return nullptr;
+    }
+    const auto * p = static_cast<const ggml_opencl_lstm_params_v1 *>(custom.userdata);
+    return p->magic == GGML_OPENCL_LSTM_PARAMS_V1_MAGIC ? p : nullptr;
