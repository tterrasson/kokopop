+++ b/src/ggml-opencl/kernels/sin.cl
@@ -0,0 +1,112 @@
+#pragma OPENCL EXTENSION cl_khr_fp16 : enable
+
+//------------------------------------------------------------------------------
+// sin / cos
+//
+// Contiguous-only, mirroring sqr.cl: ggml_cl_sin/ggml_cl_cos take the flat
+// element index, so a non-contiguous src0 is rejected in supports_op.
+//------------------------------------------------------------------------------
+
+kernel void kernel_sin_cont_f32(
+    global float * src0,
+    ulong          offset0,
+    global float * dst,
+    ulong          offsetd
+) {
+    src0 = (global float*)((global char*)src0 + offset0);
+    dst  = (global float*)((global char*)dst + offsetd);
+
+    uint gid = get_global_id(0);
+    dst[gid] = sin(src0[gid]);
+}
+
+kernel void kernel_sin_cont_f32_4(
+    global float4 * src0,
+    ulong           offset0,
+    global float4 * dst,
+    ulong           offsetd
+) {
+    src0 = (global float4*)((global char*)src0 + offset0);
+    dst  = (global float4*)((global char*)dst + offsetd);
+
+    uint gid = get_global_id(0);
+    dst[gid] = sin(src0[gid]);
+}
+
+kernel void kernel_sin_cont_f16(
+    global half * src0,
