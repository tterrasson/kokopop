+// Repack each lhs matrix [K, M] -> [M, K], padding M to Mp. Model weights are
+// immutable, so the backend runs this once and caches the result.
+kernel void kernel_mul_mm_f16_repack(
+    global const half * src,
+    ulong               off_src,
+    global       half * dst,
+    ulong               off_dst,
+    int K, int M, int Mp
+) {
+    src = (global const half *)((global const char *)src + off_src);
+    dst = (global       half *)((global       char *)dst + off_dst);
+
+    const int m = (int)get_global_id(0);
+    const int k = (int)get_global_id(1);
+    const int b = (int)get_global_id(2);
+    if (m >= Mp || k >= K) return;
+    dst[((size_t)b * K + k) * Mp + m] = m < M
+        ? src[((size_t)b * M + m) * K + k]
+        : (half)0.0f;
+}
