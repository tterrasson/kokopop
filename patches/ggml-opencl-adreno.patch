+void ggml_backend_opencl_lstm_preload(
+        ggml_backend_t backend, const float * w_hh_f32, int64_t hidden, int64_t four_hidden) {
+    if (backend == nullptr || !ggml_backend_is_opencl(backend) || w_hh_f32 == nullptr ||
+        hidden != 256 || four_hidden != 1024) {
+        return;
+    }
+    auto * backend_ctx = (ggml_backend_opencl_context *)backend->context;
+    ggml_cl_lstm_preload_weights(backend_ctx, w_hh_f32);
+}
