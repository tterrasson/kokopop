+static ggml_backend_opencl_context::lstm_weights_cl & ggml_cl_lstm_preload_weights(
+        ggml_backend_opencl_context * backend_ctx, const float * w_hh_f32) {
+    auto it = backend_ctx->lstm_weights.find(w_hh_f32);
+    if (it != backend_ctx->lstm_weights.end()) {
+        return it->second;
+    }
+
+    constexpr int H = 256, H4 = 1024;
+    std::vector<float> packed((size_t)H*H4);
+    for (int k = 0; k < H; ++k) {
+        for (int j = 0; j < H4; ++j) {
+            packed[(size_t)k*H4+j] = w_hh_f32[(size_t)j*H+k];
+        }
+    }
+
+    cl_int err;
+    ggml_backend_opencl_context::lstm_weights_cl entry;
+    CL_CHECK((entry.weights = clCreateBuffer(backend_ctx->context, CL_MEM_READ_ONLY,
+                                              packed.size()*sizeof(float), nullptr, &err), err));
+    CL_CHECK(clEnqueueWriteBuffer(backend_ctx->queue, entry.weights, CL_TRUE, 0,
+                                  packed.size()*sizeof(float), packed.data(), 0, nullptr, nullptr));
+
+    auto inserted = backend_ctx->lstm_weights.emplace(w_hh_f32, entry);
+    backend_ctx->lstm_weights_bytes += packed.size()*sizeof(float);
+    GGML_LOG_DEBUG("ggml_opencl: LSTM weights preloaded, %.1f MiB held\n",
+                   backend_ctx->lstm_weights_bytes/1024.0/1024.0);
+    return inserted.first->second;
+}
