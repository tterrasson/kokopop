+// One tap: TS_K weights in TS_K/8 aligned vector loads, then TS_K*VEC MADs.
+#define CONV1D_TAP(kw)                                                        \
+    do {                                                                      \
+        global const half * wp = wrow + (size_t)(kw) * Coutp;                  \
+        float w[TS_K];                                                        \
+        _Pragma("unroll")                                                     \
+        for (int k = 0; k + 8 <= TS_K; k += 8) {                              \
+            const float8 h = convert_float8(vload8(0, wp + k));               \
+            w[k+0]=h.s0; w[k+1]=h.s1; w[k+2]=h.s2; w[k+3]=h.s3;               \
+            w[k+4]=h.s4; w[k+5]=h.s5; w[k+6]=h.s6; w[k+7]=h.s7;               \
+        }                                                                     \
+        _Pragma("unroll")                                                     \
+        for (int k = (TS_K / 8) * 8; k < TS_K; ++k) w[k] = (float)wp[k];      \
+        _Pragma("unroll")                                                     \
+        for (int k = 0; k < TS_K; ++k) {                                      \
+            _Pragma("unroll")                                                 \
