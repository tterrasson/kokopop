+// Fetch the [M, K] copy of a contiguous f16 lhs, repacking all of its batch
+// matrices on first use. The layout makes the eight output rows computed by a
+// work item contiguous and aligned, removing both local memory and barriers
+// from the hot GEMM kernel.
+static cl_mem ggml_cl_mul_mm_f16_repacked_weights(
+        ggml_backend_opencl_context * backend_ctx,
+        cl_mem src, size_t offset, int K, int M, int Mp, int batches) {
+    const auto key = std::make_pair(src, offset);
+    auto it = backend_ctx->mul_mm_f16_repacked_weights.find(key);
+    if (it != backend_ctx->mul_mm_f16_repacked_weights.end()) {
+        return it->second;
+    }
+
+    const size_t bytes = (size_t)batches * K * Mp * sizeof(cl_half);
+    cl_int err;
+    cl_mem packed = clCreateBuffer(backend_ctx->context, CL_MEM_READ_WRITE, bytes, nullptr, &err);
+    if (err != CL_SUCCESS) {
+        return nullptr;
+    }
+
+    cl_kernel k = backend_ctx->kernel_mul_mm_f16_repack;
+    const cl_ulong off_src = offset, off_dst = 0;
+    cl_uint a = 0;
+    CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),    &src));
+    CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &off_src));
+    CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_mem),    &packed));
+    CL_CHECK(clSetKernelArg(k, a++, sizeof(cl_ulong), &off_dst));
+    for (int v : { K, M, Mp }) {
+        CL_CHECK(clSetKernelArg(k, a++, sizeof(int), &v));
+    }
+    size_t lws[3] = { 64, 1, 1 };
+    size_t gws[3] = { CEIL_DIV((size_t)Mp, lws[0]) * lws[0], (size_t)K, (size_t)batches };
+    CL_CHECK(clEnqueueNDRangeKernel(backend_ctx->queue, k, 3, nullptr, gws, lws, 0, nullptr, nullptr));
+
+    backend_ctx->mul_mm_f16_repacked_weights[key] = packed;
+    backend_ctx->mul_mm_f16_repacked_bytes += bytes;
+    GGML_LOG_DEBUG("ggml_opencl: GEMM weights repacked, K=%d M=%d batches=%d, %.1f MiB held\n",
+                   K, M, batches, backend_ctx->mul_mm_f16_repacked_bytes / 1024.0 / 1024.0);
+    return packed;
+}
