+static ggml_backend_opencl_context::lstm_weights_cl & ggml_cl_lstm_weights(
+        ggml_backend_opencl_context * backend_ctx,
+        const ggml_opencl_lstm_params_v1 * p) {
+    auto & entry = ggml_cl_lstm_preload_weights(backend_ctx, p->w_hh_f32);
+    if (entry.bias == nullptr) {
+        constexpr int H4 = 1024;
+        cl_int err;
+        CL_CHECK((entry.bias = clCreateBuffer(backend_ctx->context, CL_MEM_READ_ONLY,
+                                              H4*sizeof(float), nullptr, &err), err));
+        CL_CHECK(clEnqueueWriteBuffer(backend_ctx->queue, entry.bias, CL_TRUE, 0,
+                                      H4*sizeof(float), p->b_hh, 0, nullptr, nullptr));
