@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(KOKOPOP_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(KOKOPOP_LIBRARY "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@KOKOPOP_LIBRARY_FILE@")

find_dependency(Threads)

if(NOT TARGET kokopop::kokopop)
  add_library(kokopop::kokopop UNKNOWN IMPORTED)
  set_target_properties(kokopop::kokopop PROPERTIES
    IMPORTED_LOCATION "${KOKOPOP_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${KOKOPOP_INCLUDE_DIR}"
    # The API is C, the implementation is C++. Without this, a pure C
    # consumer of the static library links without the C++ runtime.
    IMPORTED_LINK_INTERFACE_LANGUAGES "CXX")

  # A shared kokopop resolves its own dependencies. A static one leaves them
  # to the consumer's link line, so the package brings them back here; the
  # list is what the library was actually linked against.
  if("@KOKOPOP_LIBRARY_TYPE@" STREQUAL "STATIC")
    find_dependency(ggml)
    find_dependency(yyjson)
    if("@KOKOPOP_BUNDLED_ESPEAK@" AND NOT TARGET kokopop::espeak)
      add_library(kokopop::espeak STATIC IMPORTED)
      set_and_check(_kokopop_espeak "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@kokopop-espeak@CMAKE_STATIC_LIBRARY_SUFFIX@")
      set_and_check(_kokopop_espeak_ucd "@PACKAGE_CMAKE_INSTALL_LIBDIR@/@CMAKE_STATIC_LIBRARY_PREFIX@kokopop-espeak-ucd@CMAKE_STATIC_LIBRARY_SUFFIX@")
      set_target_properties(kokopop::espeak PROPERTIES
        IMPORTED_LOCATION "${_kokopop_espeak}"
        INTERFACE_LINK_LIBRARIES "${_kokopop_espeak_ucd}")
      if(NOT MSVC)
        set_property(TARGET kokopop::espeak APPEND PROPERTY INTERFACE_LINK_LIBRARIES m)
      endif()
    endif()
    set_property(TARGET kokopop::kokopop APPEND PROPERTY
      INTERFACE_LINK_LIBRARIES "@KOKOPOP_STATIC_LINK_LIBRARIES@")
  endif()
endif()

check_required_components(kokopop)
